PROJECT_NAME=ShetiTech API
VERSION=1.0.0
API_V1_STR=/api/v1
# Default SQLite for instant local development without setup; swap with PostgreSQL/Supabase anytime
DATABASE_URL=sqlite:///./shetitech.db
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/shetitech

# CORS allowed origins (Frontend URL)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Weather API (Open-Meteo is free & keyless, optionally add OpenWeatherMap key)
OPENWEATHER_API_KEY=
